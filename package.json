{
  "name": "lens-workstation",
  "version": "0.1.0",
  "description": "LENS Workstation — Autonomous Developer Research & Coding Agent Harness",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "test": "node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:engine": "tsc -p tsconfig.node.json",
    "build:ui": "vite build",
    "build:electron": "esbuild workstation/electron/main.ts workstation/electron/preload.ts --bundle --platform=node --outdir=dist/electron --out-extension:.js=.cjs --external:electron",
    "build": "npm run build:engine && npm run build:ui && npm run build:electron",
    "package": "npm run build && electron-builder --dir",
    "pack:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder --win nsis",
    "dev:ui": "vite",
    "dev": "vite",
    "start": "electron ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.359.0",
    "monaco-editor": "^0.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.18",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.lens.workstation",
    "productName": "LENS Workstation",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "engine/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": false
  },
  "author": "LENS Team",
  "license": "Apache-2.0"
}
